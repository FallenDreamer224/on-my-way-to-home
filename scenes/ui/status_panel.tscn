[gd_scene format=3]

[node name="StatusPanel" type="PanelContainer"]
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.83, 0.8, 1)
text = "ASTRONAUT STATUS"

[node name="Unavailable" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54, 0.64, 0.68, 1)
theme_override_font_sizes/font_size = 13
text = "Readouts unavailable"

[node name="Rows" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Physical" type="HBoxContainer" parent="Content/Rows"]
layout_mode = 2
[node name="Name" type="Label" parent="Content/Rows/Physical"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "Physical condition"
[node name="Value" type="Label" parent="Content/Rows/Physical"]
layout_mode = 2
text = "-"

[node name="Emotional" type="HBoxContainer" parent="Content/Rows"]
layout_mode = 2
[node name="Name" type="Label" parent="Content/Rows/Emotional"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "Emotional state"
[node name="Value" type="Label" parent="Content/Rows/Emotional"]
layout_mode = 2
text = "-"

[node name="Sleep" type="HBoxContainer" parent="Content/Rows"]
layout_mode = 2
[node name="Name" type="Label" parent="Content/Rows/Sleep"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "Sleep"
[node name="Value" type="Label" parent="Content/Rows/Sleep"]
layout_mode = 2
text = "-"

[node name="Radiation" type="HBoxContainer" parent="Content/Rows"]
