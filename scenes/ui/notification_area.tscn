[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/notification_area.gd" id="1"]

[node name="Notifications" type="PanelContainer"]
visible = false
mouse_filter = 2
theme_type_variation = &"NoticePanel"
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"SectionLabel"
text = "SYSTEM NOTICE"

[node name="Message" type="Label" parent="Content"]
custom_minimum_size = Vector2(228, 0)
layout_mode = 2
mouse_filter = 2
text = "No new messages"
autowrap_mode = 3
max_lines_visible = 4
text_overrun_behavior = 3

[node name="Expiry" type="Timer" parent="."]
one_shot = true
