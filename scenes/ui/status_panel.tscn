[node name="Name" type="Label" parent="Content/Rows/Radiation"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "Radiation"
[node name="Value" type="Label" parent="Content/Rows/Radiation"]
layout_mode = 2
text = "-"

[node name="Cardiac" type="HBoxContainer" parent="Content/Rows"]
